# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file.

ENVIRONMENT=development

# Where Streamlit finds the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# SQLite database file (created in Phase 3)
DATABASE_PATH=data/reliefmesh.db

# LLM provider: "gemini" (free tier), "groq" (free tier, faster/more generous
# rate limits), or "ollama" (100% open source, local)
LLM_PROVIDER=groq

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

