# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file.

ENVIRONMENT=development

# Where Streamlit finds the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# SQLite database file (created in Phase 3)
DATABASE_PATH=data/reliefmesh.db

# LLM provider: "gemini" (free tier) or "ollama" (100% open source, local)
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
